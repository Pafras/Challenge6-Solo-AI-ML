{
  "_comment": "Single source of truth for the beat. Read by scripts/make_samples.py (previews) and bundled into the macOS app. One step = one eighth note (60 / bpm / 2 s). A step lists the sounds that hit together: K kick, H hi-hat, S snare, C clap, '-' rest. While an expression is held, the variations rotate in 'order', each lasting 'bars_per_variation' bars; a new expression always starts at A, at the next bar.",
  "bars_per_variation": 2,
  "order": ["A", "B", "A", "C"],
  "samples_per_sound": 3,
  "gain": {"K": 1.0, "S": 0.85, "C": 0.75, "H": 0.45},
  "expressions": {
    "neutral": {
      "mood": "calm",
      "bpm": 90,
      "A": ["K", "H", "-", "H", "K", "H", "S", "H"],
      "B": ["K", "H", "-", "H", "K", "C", "S", "H"],
      "C": ["K", "H", "S", "H", "K", "H", "SC", "-"]
    },
    "happy": {
      "mood": "groove",
      "bpm": 110,
      "A": ["KH", "H", "SH", "H", "KH", "KH", "SH", "H"],
      "B": ["KH", "H", "SH", "C", "KH", "H", "SH", "CH"],
      "C": ["KH", "H", "SH", "H", "KH", "S", "SC", "SC"]
    },
    "angry": {
      "mood": "heavy",
      "bpm": 130,
      "A": ["K", "K", "S", "H", "K", "K", "S", "SH"],
      "B": ["K", "H", "S", "K", "K", "K", "SC", "H"],
      "C": ["K", "K", "S", "S", "K", "SC", "S", "SC"]
    },
    "surprise": {
      "mood": "variation",
      "bpm": 120,
      "A": ["KH", "C", "SH", "C", "KH", "S", "H", "C"],
      "B": ["C", "KH", "S", "H", "KC", "H", "S", "C"],
      "C": ["KH", "SC", "KH", "SC", "K", "S", "C", "C"]
    },
    "sad": {
      "mood": "sparse",
      "bpm": 70,
      "A": ["K", "-", "H", "-", "S", "-", "H", "-"],
      "B": ["K", "-", "H", "K", "S", "-", "H", "-"],
      "C": ["K", "-", "H", "-", "S", "-", "C", "H"]
    }
  }
}
