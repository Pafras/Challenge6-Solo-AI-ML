.DS_Store
__pycache__/
*.pyc
.venv/
venv/

# Datasets, checkpoints and converted models — too big for git
data/
BeatboxAudioDataset/
AVP_Dataset-2/
*.wav
*.mp3
!audio/samples/*.wav
*.pt
*.pth
*.mlmodel
*.mlpackage/
# The app bundles copies of the model and the beat samples
# (scripts/sync_app_assets.py), so those copies are committed.
!EmotionBeatbox/EmotionBeatbox/Resources/*.wav
!EmotionBeatbox/EmotionBeatbox/Resources/EmotionClassifier.mlpackage/
# Its weights sit in Data/, which the data/ rule above also matches on a
# case-insensitive Mac; without this line the app would ship without them.
!EmotionBeatbox/EmotionBeatbox/Resources/EmotionClassifier.mlpackage/**
!EmotionBeatbox/EmotionBeatbox/Resources/LandmarkClassifier.mlpackage/
!EmotionBeatbox/EmotionBeatbox/Resources/LandmarkClassifier.mlpackage/**

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
